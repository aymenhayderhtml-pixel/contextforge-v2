{
  "name": "@contextforge/app",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell. Step 2 carries only the native-module check; the UI screens arrive in Step 4.",
  "type": "module",
  "main": "./dist/electron/main.js",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --build",
    "build:electron": "tsc --build",
    "rebuild:native": "electron-rebuild -f -w tree-sitter -w tree-sitter-javascript -w tree-sitter-gdscript -w tree-sitter-typescript",
    "check:native": "npm run rebuild:native && electron --no-sandbox dist/electron/check-native.js",
    "dev": "vite",
    "build:ui": "vite build",
    "start": "npm run build:ui && electron dist/electron/main.js"
  },
  "dependencies": {
    "@contextforge/core": "*",
    "three": "0.180.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "^44.5.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "svelte": "^5.19.0",
    "esbuild": "^0.25.0",
    "vite": "^6.3.6",
    "@types/three": "0.180.0"
  }
}