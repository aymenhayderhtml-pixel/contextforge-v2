{
  "name": "@contextforge/core",
  "version": "0.1.0",
  "private": true,
  "description": "Core engine: dependency graph, parsers, patch engine, history. No UI, no DOM, no imports from app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "tree-sitter": "^0.25.1",
    "tree-sitter-gdscript": "^6.1.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^3.24.1"
  }
}